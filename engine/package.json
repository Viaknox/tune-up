{
  "name": "agenttuneup",
  "version": "0.1.0-rc.0",
  "description": "Agent Tune-Up: check an AI agent from its chats or a test suite, with a strict CI gate. By Viaknox.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://agenttuneup.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Viaknox/tune-up.git",
    "directory": "engine"
  },
  "bin": {
    "agenttuneup": "cli.js"
  },
  "files": [
    "cli.js",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test:promised": "node scripts/test.mjs --test-name-pattern=promised",
    "test": "node scripts/test.mjs",
    "mutate:gate": "node scripts/mutate.mjs --target src/gate.js --tests test/gate.test.js --fail-on-survivors"
  },
  "publishConfig": {
    "tag": "next"
  }
}
